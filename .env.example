# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
# Chegam só ao provider-fake e ao gateway (nunca ao serviço app).
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# AI Gateway (LiteLLM). Valores de laboratório, fixos para que `cp .env.example .env` baste.
# Master key: só o gateway a conhece (cria as chaves virtuais na subida).
LITELLM_MASTER_KEY=sk-litellm-master-0001
# Chave virtual da aplicação: a única credencial que o serviço app recebe.
HELPDESK_GATEWAY_KEY=sk-helpdesk-app-0001
# Senha do Postgres do gateway.
GATEWAY_DB_PASSWORD=litellm-lab-0001
