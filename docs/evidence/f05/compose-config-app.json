{
  "build": {
    "context": "C:\\dev\\desafio-arquitetura-era-ia-1\\app",
    "dockerfile": "Dockerfile"
  },
  "command": null,
  "depends_on": {
    "gateway": {
      "condition": "service_healthy",
      "required": true
    },
    "provider-fake": {
      "condition": "service_healthy",
      "required": true
    }
  },
  "entrypoint": null,
